{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.nouter/x",
  "title": "X",
  "description": "Posts, timelines and search on X",
  "version": "1.0.0",
  "_meta": {
    "ai.nouter.directory": {
      "id": "x",
      "color": "#FFFFFF",
      "landing": "X, con la API de tu empresa",
      "gatekeeper": {
        "package": "gatekeeper-x",
        "settings": [
          {
            "field": "clientId",
            "variable": "CLIENT_ID",
            "into": "secrets"
          },
          {
            "field": "clientSecret",
            "variable": "CLIENT_SECRET",
            "into": "secrets",
            "secret": true
          }
        ]
      }
    }
  }
}
