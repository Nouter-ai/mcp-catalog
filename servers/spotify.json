{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.nouter/spotify",
  "title": "Spotify",
  "description": "Playback, playlists and your library",
  "version": "1.0.0",
  "_meta": {
    "ai.nouter.directory": {
      "id": "spotify",
      "color": "#FFFFFF",
      "gatekeeper": {
        "package": "gatekeeper-spotify",
        "settings": [
          {
            "field": "clientId",
            "variable": "CLIENT_ID",
            "into": "secrets"
          },
          {
            "field": "clientSecret",
            "variable": "CLIENT_SECRET",
            "into": "secrets",
            "secret": true
          }
        ],
        "flag": "directory-nativos"
      },
      "categories": [
        "design-media"
      ],
      "publisher": "Spotify",
      "verified": true,
      "signIn": "account"
    }
  }
}
