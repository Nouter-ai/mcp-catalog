{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.nouter/gitlab",
  "title": "GitLab",
  "description": "Repositories, issues and merge requests",
  "version": "1.0.0",
  "_meta": {
    "ai.nouter.directory": {
      "id": "gitlab",
      "color": "#FFFFFF",
      "landing": "GitLab, con la app de tu empresa",
      "gatekeeper": {
        "package": "gatekeeper-gitlab",
        "settings": [
          {
            "field": "clientId",
            "variable": "CLIENT_ID",
            "into": "secrets"
          },
          {
            "field": "clientSecret",
            "variable": "CLIENT_SECRET",
            "into": "secrets",
            "secret": true
          }
        ]
      }
    }
  }
}
