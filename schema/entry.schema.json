{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nouter-ai/mcp-catalog/schema/entry.schema.json",
  "title": "Entrada del Directory de MCP de nouter (server.json del MCP Registry)",
  "description": "Para el editor: el server.json del estándar (schema/vendor) más lo de Nouter en _meta. La validación que manda es scripts/server-check.ts.",
  "allOf": [
    {
      "$ref": "vendor/server.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "$schema",
    "title",
    "remotes",
    "_meta"
  ],
  "properties": {
    "title": {
      "maxLength": 40
    },
    "description": {
      "maxLength": 60
    },
    "remotes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "properties": {
          "type": {
            "const": "streamable-http"
          },
          "url": {
            "pattern": "^https://"
          }
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": [
        "ai.nouter.directory"
      ],
      "propertyNames": {
        "const": "ai.nouter.directory"
      },
      "properties": {
        "ai.nouter.directory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "description",
            "color",
            "settings",
            "trustedLogin"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^(?!mcp-)[a-z][a-z0-9-]{0,19}$",
              "not": {
                "enum": [
                  "context",
                  "scheduler",
                  "mcp",
                  "google",
                  "slack",
                  "github",
                  "salesforce",
                  "netsuite"
                ]
              }
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-F]{6}$"
            },
            "landing": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "es"
              ],
              "properties": {
                "es": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            },
            "settings": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field",
                      "variable"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "pattern": "^[a-zA-Z]{1,30}$"
                      },
                      "variable": {
                        "const": "MCP_FIXED_CLIENT_ID"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field",
                      "variable",
                      "secret"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "pattern": "^[a-zA-Z]{1,30}$"
                      },
                      "variable": {
                        "const": "MCP_FIXED_CLIENT_SECRET"
                      },
                      "secret": {
                        "const": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "field",
                      "fills"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "pattern": "^[a-zA-Z]{1,30}$"
                      },
                      "fills": {
                        "const": "url"
                      }
                    }
                  }
                ]
              }
            },
            "trustedLogin": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        }
      }
    }
  }
}
