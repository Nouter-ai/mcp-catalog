{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nouter-ai/mcp-catalog/schema/entry.schema.json",
  "title": "Entrada del catálogo de MCP de nouter",
  "description": "La validación que manda es scripts/entry.ts; este esquema es para el editor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "url",
    "name",
    "color",
    "tagline",
    "description",
    "settings",
    "trustedLogin"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?!mcp-)[a-z][a-z0-9-]{0,19}$",
      "not": {
        "enum": [
          "context",
          "scheduler",
          "mcp",
          "google",
          "slack"
        ]
      }
    },
    "registry": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9._-]+$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "landing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "es"
      ],
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "settings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "variable"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-zA-Z]{1,30}$"
              },
              "variable": {
                "const": "MCP_FIXED_CLIENT_ID"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "variable",
              "secret"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-zA-Z]{1,30}$"
              },
              "variable": {
                "const": "MCP_FIXED_CLIENT_SECRET"
              },
              "secret": {
                "const": true
              }
            }
          }
        ]
      }
    },
    "trustedLogin": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    }
  }
}
